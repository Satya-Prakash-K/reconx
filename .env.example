# ============================================
# ReconX Environment Configuration
# Copy to .env and fill in your values
# ============================================

# ── General ──────────────────────────────────
RECONX_ENV=development
RECONX_DEBUG=true
RECONX_LOG_LEVEL=INFO
RECONX_SECRET_KEY=change-me-to-a-random-64-char-string
RECONX_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# ── API Gateway ──────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GRPC_PORT=50051

# ── JWT Authentication ───────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reconx
POSTGRES_USER=reconx
POSTGRES_PASSWORD=reconx_secure_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Elasticsearch / OpenSearch ───────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic_password
ELASTICSEARCH_INDEX_PREFIX=reconx

# ── Neo4j ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_CELERY_DB=1
REDIS_STREAMS_DB=2

# ── Kafka ────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=reconx
KAFKA_CONSUMER_GROUP=reconx-workers
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Temporal ─────────────────────────────────
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=reconx
TEMPORAL_TASK_QUEUE=reconx-recon

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI / LLM ────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
VLLM_BASE_URL=http://localhost:8001

# ── Qdrant (Vector DB) ──────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reconx_findings
QDRANT_API_KEY=

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_GLOBAL_RPM=1000
RATE_LIMIT_PER_TARGET_RPM=100
RATE_LIMIT_PER_TOOL_RPM=50
SAFE_MODE=true
SAFE_MODE_DELAY_MS=500

# ── Recon Engine ─────────────────────────────
RECON_ENGINE_HOST=localhost
RECON_ENGINE_PORT=50052
RECON_MAX_CONCURRENT_SCANS=5
RECON_OUTPUT_DIR=/data/recon/output
RECON_SCREENSHOTS_DIR=/data/recon/screenshots

# ── Observability ────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=reconx
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
LOKI_URL=http://localhost:3100

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=ReconX

# ── Vulnerability Engine ─────────────────────
VULN_ENGINE_HOST=0.0.0.0
VULN_ENGINE_PORT=8002
VULN_MAX_CONCURRENT_SCANS=10
VULN_SAFE_MODE=true
VULN_DEFAULT_THROTTLE_RPS=10
VULN_WAF_EVASION=false
VULN_BROWSER_TESTING=true
VULN_AI_HYPOTHESIS=true

# ── Ray Cluster ──────────────────────────────
RAY_ADDRESS=auto
RAY_NUM_WORKERS=4
RAY_DASHBOARD_PORT=8265

# ── Selenium Grid ────────────────────────────
SELENIUM_HUB_URL=http://localhost:4444
SELENIUM_MAX_SESSIONS=10

# ── External Tools ───────────────────────────
BURP_API_URL=https://localhost:8834
BURP_API_KEY=
NUCLEI_RATE_LIMIT=100
NUCLEI_SEVERITY=medium,high,critical
SQLMAP_LEVEL=3
SQLMAP_RISK=2

# ── Triage & Report Engine ───────────────────
TRIAGE_ENGINE_HOST=0.0.0.0
TRIAGE_ENGINE_PORT=8003
TRIAGE_AI_ENRICHMENT=true
TRIAGE_EMBEDDING_MODEL=all-MiniLM-L6-v2
TRIAGE_DEDUP_THRESHOLD=0.92
TRIAGE_AUTO_REPORT=true
TRIAGE_DEFAULT_FORMAT=hackerone
