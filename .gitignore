# ============================================
# ReconX - Comprehensive .gitignore
# ============================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/
vault/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
.venv/
venv/
env/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Rust
target/
**/*.rs.bk
Cargo.lock
!apps/recon-engine/Cargo.lock

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/

# Docker
docker-compose.override.yml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Kubernetes
kubeconfig
*.kubeconfig

# Logs
logs/
*.log

# Data volumes
data/
volumes/

# Recon output (can be large)
output/
results/
screenshots/
*.sqlite3

# OS
.DS_Store
Thumbs.db
Desktop.ini
